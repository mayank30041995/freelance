{
  "name": "@mayank30041995/jobber-shared",
  "version": "0.0.12",
  "license": "MIT",
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "types": "./build/src/index.d.ts",
  "description": "Helpers library for Jobber app",
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && tsc --outDir build/src",
    "build:cjs": "cross-env NODE_ENV=production BABEL_ENV=cjs babel src --presets=./scripts/babel-preset.js --extensions .ts,.tsx --ignore src/**/*.specs.tsx --out-dir build/cjs --source-maps",
    "build:esm": "cross-env NODE_ENV=production BABEL_ENV=esm babel src --presets=./scripts/babel-preset.js --extensions .ts,.tsx --ignore src/**/*.specs.tsx --out-dir build/esm --source-maps"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "keywords": [],
  "author": "Mayank Sharma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayank30041995/jobber-shared.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    }
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.12.2",
    "cloudinary": "^2.1.0",
    "elastic-apm-node": "^4.18.0",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "cross-env": "^10.1.0"
  }
}
