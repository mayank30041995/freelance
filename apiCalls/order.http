@orderId = TEST-ORDER-001
@sellerId = 10
@buyerId = 6ab11939df8009bb23d7c81b
@userTo = REPLACE_WITH_USER_TO
@notificationId = REPLACE_WITH_NOTIFICATION_ID

@paymentIntentId = REPLACE_WITH_PAYMENT_INTENT_ID

@gigId = REPLACE_WITH_GIG_ID

@sellerUsername = REPLACE_WITH_SELLER_USERNAME
@sellerEmail = REPLACE_WITH_SELLER_EMAIL
@sellerImage = REPLACE_WITH_SELLER_IMAGE

@buyerUsername = REPLACE_WITH_BUYER_USERNAME
@buyerEmail = REPLACE_WITH_BUYER_EMAIL
@buyerImage = REPLACE_WITH_BUYER_IMAGE

@gigCoverImage = REPLACE_WITH_GIG_COVER_IMAGE
@gigMainTitle = REPLACE_WITH_GIG_MAIN_TITLE
@gigBasicTitle = REPLACE_WITH_GIG_BASIC_TITLE
@gigBasicDescription = REPLACE_WITH_GIG_BASIC_DESCRIPTION

### 1. GET ORDER BY ORDER ID
GET {{baseUrl}}/{{urlPath}}/order/{{orderId}}
Accept: application/json
Content-Type: application/json

###

### 2. GET SELLER ORDERS
GET {{baseUrl}}/{{urlPath}}/order/seller/{{sellerId}}
Accept: application/json
Content-Type: application/json

###

### 3. GET BUYER ORDERS
GET {{baseUrl}}/{{urlPath}}/order/buyer/{{buyerId}}
Accept: application/json
Content-Type: application/json

###

### 4. GET ORDER NOTIFICATIONS
GET {{baseUrl}}/{{urlPath}}/order/notification/{{userTo}}
Accept: application/json
Content-Type: application/json

###

### 5. CREATE PAYMENT INTENT
POST {{baseUrl}}/{{urlPath}}/order/create-payment-intent
Accept: application/json
Content-Type: application/json

{
  "price": 50,
  "buyerId": "{{buyerId}}"
}

###

### 6. CREATE ORDER
POST {{baseUrl}}/{{urlPath}}/order
Accept: application/json
Content-Type: application/json

{
  "offer": {
    "gigTitle": "Test Gig",
    "price": 20,
    "description": "Test order description",
    "deliveryInDays": 3,
    "oldDeliveryDate": "2026-10-08",
    "accepted": true,
    "cancelled": false
  },
  "gigId": "test-gig-1",
  "sellerId": "10",
  "sellerUsername": "seller",
  "sellerEmail": "seller@test.com",
  "sellerImage": "https://example.com/seller.jpg",
  "gigCoverImage": "https://example.com/gig.jpg",
  "gigMainTitle": "Test Gig Main Title",
  "gigBasicTitle": "Basic Package",
  "gigBasicDescription": "Basic test package",
  "buyerId": "25",
  "buyerUsername": "Panny",
  "buyerEmail": "panny@test.com",
  "buyerImage": "https://example.com/buyer.jpg",
  "status": "Pending",
  "orderId": "TEST-ORDER-001",
  "invoiceId": "TEST-INVOICE-001",
  "quantity": 1,
  "price": 20,
  "requirements": "Test requirements",
  "paymentIntent": "pi_1UNAcCA1T2K9h4zLMhyO7Wn5"
}

