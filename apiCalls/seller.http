    {
      "language": "English",
      "level": "Native"
    }
  ],
  "responseTime": 2,
  "experience": [
    {
      "company": "Tech Solutions",
      "title": "Senior Full Stack Developer",
      "startDate": "January 2022",
      "endDate": "Present",
      "description": "Building and maintaining full-stack web applications.",
      "currentlyWorkingHere": true
    }
  ],
  "education": [
    {
      "country": "India",
      "university": "ABC University",
      "title": "Bachelor of Technology",
      "major": "Computer Science",
      "year": "2021"
    }
  ],
  "socialLinks": [
    "https://github.com/johndoe"
  ],
  "certificates": [
    {
      "name": "Full Stack Development",
      "from": "Tech Academy",
      "year": 2023
    }
  ]
}

###

### Seed sellers
PUT {{baseUrl}}/{{urlPath}}/seller/seed/10
Content-Type: application/json
Accept: application/json
withCredentials:true

{}


# There are exactly 6 seller gateway routes:

# Seller routes
# Method	Endpoint	Auth
# GET	/seller/id/:sellerId	Required
# GET	/seller/username/:username	Required
# GET	/seller/random/:size	Required
# POST	/seller/create	Required
# PUT	/seller/:sellerId	Required
# PUT	/seller/seed/:count	Required


# GET  /seller/id/:sellerId
# GET  /seller/username/:username
# GET  /seller/random/:size
# POST /seller/create
# PUT  /seller/:sellerId
# PUT  /seller/seed/:count