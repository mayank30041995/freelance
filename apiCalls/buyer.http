    }
  ]
}

###

### Seed sellers
PUT {{baseUrl}}/{{urlPath}}/seller/seed/10
Content-Type: application/json
Accept: application/json
withCredentials:true

{}

# http://localhost:4000/api/gateway/v1
# Buyer routes
# Method	Endpoint	Auth
# GET	/buyer/email	Required
# GET	/buyer/username	Required
# GET	/buyer/:username	Required