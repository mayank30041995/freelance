@baseUrl = http://localhost:4000
@urlPath = api/gateway/v1

### =====================================================
### BUYER
### =====================================================

### Get current buyer by email
GET {{baseUrl}}/{{urlPath}}/buyer/email
Content-Type: application/json
Accept: application/json
withCredentials:true

###

### Get current buyer by username
GET {{baseUrl}}/{{urlPath}}/buyer/username
Content-Type: application/json
Accept: application/json
withCredentials:true

###

### Get buyer by username
GET {{baseUrl}}/{{urlPath}}/buyer/Thicklance
Content-Type: application/json
Accept: application/json
withCredentials:true


### =====================================================
### SELLER
### =====================================================

### Get seller by ID
GET {{baseUrl}}/{{urlPath}}/seller/id/SELLER_ID
Content-Type: application/json
Accept: application/json
withCredentials:true

###

### Get seller by username
GET {{baseUrl}}/{{urlPath}}/seller/username/Thicklance
Content-Type: application/json
Accept: application/json
withCredentials:true

###

### Get random sellers
GET {{baseUrl}}/{{urlPath}}/seller/random/10
Content-Type: application/json
Accept: application/json
withCredentials:true

###

### Create seller
POST {{baseUrl}}/{{urlPath}}/seller/create
Content-Type: application/json
Accept: application/json
withCredentials:true

{
  "profilePublicId": "PROFILE_PUBLIC_ID",
  "fullName": "John Doe",
  "email": "john@example.com",
  "profilePicture": "https://example.com/profile.jpg",
  "description": "Full-stack developer with experience building web applications.",
  "oneliner": "Full-stack developer",
  "country": "India",
  "skills": [
    "Web development",
    "Programming"
  ],
  "languages": [
    {
      "language": "English",
      "level": "Native"
    }
  ],
  "responseTime": 2,
  "experience": [
    {
      "company": "Tech Solutions",
      "title": "Full Stack Developer",
      "startDate": "January 2022",
      "endDate": "Present",
      "description": "Developed and maintained full-stack web applications.",
      "currentlyWorkingHere": true
    }
  ],
  "education": [
    {
      "country": "India",
      "university": "ABC University",
      "title": "Bachelor of Technology",
      "major": "Computer Science",
      "year": "2021"
    }
  ],
  "socialLinks": [
    "https://github.com/johndoe"
  ],
  "certificates": [
    {
      "name": "Full Stack Development",
      "from": "Tech Academy",
      "year": 2023
    }
  ]
}

###

### Update seller
PUT {{baseUrl}}/{{urlPath}}/seller/SELLER_ID
Content-Type: application/json
Accept: application/json
withCredentials:true

{
  "profilePublicId": "PROFILE_PUBLIC_ID",
  "fullName": "John Doe",
  "profilePicture": "https://example.com/profile.jpg",
  "description": "Updated full-stack developer profile.",
