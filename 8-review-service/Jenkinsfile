
namespace = "production"
serviceName = "jobber-review"
service = "Jobber Reviews"

def groovyMethods

m1 = System.currentTimeMillis()



pipeline {
    agent {
        label 'Jenkins-Agent'
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    tools {
        nodejs 'NodeJS'
    }

    environment {
        IMAGE_NAME = 'mayank30041995/jobber-review'
        IMAGE_TAG = "stable-${BUILD_NUMBER}"
    }

    stages {

        stage('Cleanup Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github',
                    url: 'https://github.com/mayank30041995/freelance.git'
            }
        }

        stage('Verify Node and NPM') {
            steps {
                sh '''
                    node --version
                    npm --version

                    npm_major=$(npm --version | cut -d. -f1)

                    test "$npm_major" = "11" || {
                        echo "Expected npm 11"
                        exit 1
                    }
                '''
            }
        }

        stage('Prepare Environment') {
            steps {
                dir('8-review-service') {
                    withCredentials([
                        string(
                            credentialsId: 'github-packages-token',
                            variable: 'GITHUB_PACKAGES_TOKEN'
                        )
                    ]) {
                        sh '''
                            set -eu

                            cleanup() {
                                rm -f .npmrc
                            }

                            trap cleanup EXIT

                            cat > .npmrc <<EOF
@mayank30041995:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}
always-auth=true
EOF

                            npm ci
                        '''
                    }
                }
            }
        }

        stage('Lint Check') {
            steps {
                dir('8-review-service') {
                    sh 'npm run lint:check'
                }
            }
        }

        stage('Code Format Check') {
            steps {
                dir('8-review-service') {
                    sh 'npm run prettier:check'
                }
            }
        }

        stage('Unit Test') {
            steps {
                dir('8-review-service') {
                    sh 'npm run test'
                }
            }
        }
    }

    post {
        success {
            echo 'Jobber Reviews pipeline completed successfully.'
        }

        failure {
            echo 'Jobber Reviews pipeline failed. Check the stage logs.'
        }

        always {
            echo "Build number: ${BUILD_NUMBER}"
            echo "Build result: ${currentBuild.currentResult}"
        }
    }
}



